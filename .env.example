# Copie para ".env" e ajuste. O .env de verdade NÃO vai para o Git.

PORT=3000

# --- serviços de trás ---
PRODUTOS_API_URL=http://localhost:3001
# mesma chave configurada em INTERNAL_API_KEY no ms-produtos (deixe vazio se lá estiver desligado)
PRODUTOS_API_KEY=

PEDIDOS_API_URL=http://localhost:3002
PEDIDOS_API_KEY=

# URL base da Function App já com /api. Vazio = /aggregated-data marca a Function como "skipped".
# local (func start):  http://localhost:7071/api
# nuvem:               https://<nome-da-function-app>.azurewebsites.net/api
FUNCTION_URL=
# function key do HTTP Trigger (na nuvem). Local com func start não precisa.
FUNCTION_KEY=

# --- segurança ---
# Quando preenchido, o BFF só aceita chamadas com o cabeçalho x-gateway-secret igual a este valor
# (quem injeta é a policy do API Gateway). Vazio = aceita chamadas diretas (bom para desenvolver).
GATEWAY_SECRET=
# URL pública do gateway, só para aparecer como opção de servidor no Swagger
GATEWAY_URL=

# origens liberadas no CORS, separadas por vírgula, ou * para todas
CORS_ORIGIN=*
RATE_LIMIT_PER_MINUTE=300

# --- ajustes finos ---
UPSTREAM_TIMEOUT_MS=10000
LOG_LEVEL=info
# URL pública do próprio BFF (aparece no Swagger)
PUBLIC_URL=
